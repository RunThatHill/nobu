{
  "rules": {
    ".read": false,
    ".write": false,
    "nobu": {
      "state": {
        ".read": "auth != null",
        ".write": false
      },
      "lastResult": {
        ".read": "auth != null",
        ".write": false
      },
      "searchResults": {
        ".read": "auth != null",
        ".write": false
      },
      "commands": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$cmdId": {
          ".validate": "newData.hasChildren(['action', 'createdAt'])"
        }
      },
      "users": {
        "$userId": {
          ".read": "auth != null && (auth.uid == $userId || auth.uid == 'discord:' + $userId)",
          ".write": "auth != null && (auth.uid == $userId || auth.uid == 'discord:' + $userId)",
          "playlists": {
            ".read": "auth != null && (auth.uid == $userId || auth.uid == 'discord:' + $userId)",
            ".write": "auth != null && (auth.uid == $userId || auth.uid == 'discord:' + $userId)"
          }
        }
      }
    }
  }
}
