{
  "rules": {
    ".read": false,
    ".write": false,
    "nobu": {
      "state": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'abdelmassehmourad@gmail.com')",
        ".write": false
      },
      "lastResult": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'abdelmassehmourad@gmail.com')",
        ".write": false
      },
      "searchResults": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'abdelmassehmourad@gmail.com')",
        ".write": false
      },
      "commands": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'abdelmassehmourad@gmail.com')",
        ".write": "auth != null && auth.token.email_verified == true && (auth.token.email == 'abdelmassehmourad@gmail.com')",
        "$cmdId": {
          ".validate": "newData.hasChildren(['action', 'createdAt', 'userEmail']) && newData.child('userEmail').val() == auth.token.email"
        }
      }
    }
  }
}
