# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here

# Optional: Guild ID for instant slash command registration during development
# Leave empty for global slash commands (takes a few minutes to sync everywhere)
GUILD_ID=

# Bot Customization
BOT_PREFIX=!
DEFAULT_VOLUME=50

# Web server port for free cloud hosting platforms (Render, Koyeb, etc.)
PORT=3000

# Optional: Spotify Credentials (increases Spotify rate limits / accuracy)
# Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: SoundCloud Client ID (avoids rate limits)
SOUNDCLOUD_CLIENT_ID=
